# 为防止意味将外部环境变量泄露到客户端，只能通过 VITE_ 为前缀的变量才会暴露给 vite 构建使用
# js文件通过 "import.meta.env"取值

NODE_env = 'production'
# pro 基地址
VITE_BASE_API = '/api'

VITE_BASE_URL = 'https://new.scs.work/'

